{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Intodo",
  "version": "1.0.0",
  "identifier": "com.intodo.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Intodo",
        "label": "main",
        "width": 1080,
        "height": 760,
        "minWidth": 460,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false
      },
      {
        "title": "",
        "label": "overlay",
        "width": 56,
        "height": 56,
        "resizable": false,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "visible": true,
        "x": 500,
        "y": 20
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
